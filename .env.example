# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to version control.

# Gmail: use an App Password (Google Account -> Security -> App Passwords),
# NOT your normal login password. 2-Step Verification must be enabled first.
# Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_SENDER_NAME=DV Analytics Team

# App login screen — pick your own credentials, never reuse a real password here.
# This file is safe to commit since it only has placeholders; your real .env is gitignored.
APP_USERNAME=admin@example.com
APP_PASSWORD=choose-a-strong-password

# --- Google Sheet (read-only, API key) — Tab 5 ---
# The Sheet MUST be shared as "Anyone with the link — Viewer" — an API key
# has no user identity, so Google will not authorize it against a private
# sheet. See README "⑤ Sheet + QR Certificates" for why this is read-only
# and what that means for certificate numbering.
GOOGLE_SHEETS_API_KEY=
DEFAULT_SHEET_URL=

# --- Google Sheet WRITE-BACK (optional) ---
# Set ONE of these to let the app write Certificate Number / Certificate
# Status / Generated Date / Email Status / Email Sent Date back into the
# sheet automatically. Without either set, the app falls back to read-only
# access above plus the "export CSV, paste in manually" button.
#   1. Create a service account in Google Cloud Console, download its JSON key.
#   2. Share the Google Sheet with the JSON's "client_email" as an Editor
#      (this does NOT require "Anyone with the link" sharing).
#   3. Set ONE of the two variables below (path is easiest locally; the raw
#      JSON contents variable is for platforms like Streamlit Cloud where
#      you'd paste the JSON into Streamlit secrets instead of a file path).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENTS=

# --- Certificate numbering (format: INSTITUTE-COURSE-YEAR-######) ---
CERT_INSTITUTE_CODE=DVA
CERT_COURSE_CODE=APIDS
CERT_YEAR=2026

# Where issued certificate numbers / send history live (local SQLite — the
# source of truth, since the API key above can't write back to the Sheet).
CERT_DB_PATH=./data/certificates.db

# --- QR / verification ---
# QR codes point to {this}/verify/{certificate_number}. Set to your public
# GitHub Pages URL or custom domain:
CERTIFICATE_VERIFICATION_BASE_URL=https://mdsajid-ui.github.io/DV_Course_Certificate

# Path to the master certificate .pptx (the one with the "[ ]" placeholders
# for name / certificate number / date). Defaults to the bundled template.
CERTIFICATE_TEMPLATE_PPTX=

# --- verify_service (the separate Flask app serving /verify/{number}) ---
VERIFY_SERVICE_PORT=8000

# --- Amazon S3 / S3-Compatible Object Storage (e.g. AWS S3, UpCloud) ---
# Endpoint URL: leave empty for standard AWS S3, or set custom endpoint:
AWS_S3_ENDPOINT_URL=https://t8fcc.upcloudobjects.com
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=b1storage
AWS_REGION=us-east-1

# S3 Presigned Download URL Expiration (in seconds, default: 3600 = 1 hour)
S3_PRESIGNED_EXPIRY_SECONDS=3600

# Application Secret Key for signing secure student download tokens (HMAC-SHA256)
APP_SECRET_KEY=change_this_to_a_secure_random_hex_string

# Base URL for student certificate download links sent in emails
CERTIFICATE_DOWNLOAD_BASE_URL=http://localhost:8000
