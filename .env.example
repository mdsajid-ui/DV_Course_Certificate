# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to version control.

# Gmail: use an App Password (Google Account -> Security -> App Passwords),
# NOT your normal login password. 2-Step Verification must be enabled first.
# Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_SENDER_NAME=DV Analytics Team

# App login screen — pick your own credentials, never reuse a real password here.
# This file is safe to commit since it only has placeholders; your real .env is gitignored.
APP_USERNAME=admin@example.com
APP_PASSWORD=choose-a-strong-password

# --- Google Sheet (read-only, API key) — Tab 5 ---
# The Sheet MUST be shared as "Anyone with the link — Viewer" — an API key
# has no user identity, so Google will not authorize it against a private
# sheet. See README "⑤ Sheet + QR Certificates" for why this is read-only
# and what that means for certificate numbering.
GOOGLE_SHEETS_API_KEY=
DEFAULT_SHEET_URL=

# --- Certificate numbering (format: INSTITUTE-COURSE-YEAR-######) ---
CERT_INSTITUTE_CODE=DVA
CERT_COURSE_CODE=APIDS
CERT_YEAR=2026

# Where issued certificate numbers / send history live (local SQLite — the
# source of truth, since the API key above can't write back to the Sheet).
CERT_DB_PATH=./data/certificates.db

# --- QR / verification ---
# QR codes point to {this}/verify/{certificate_number}. Change only this
# value when moving from localhost to your production domain.
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:8000

# Path to the master certificate .pptx (the one with the "[ ]" placeholders
# for name / certificate number / date). Defaults to the bundled template.
CERTIFICATE_TEMPLATE_PPTX=

# --- verify_service (the separate Flask app serving /verify/{number}) ---
VERIFY_SERVICE_PORT=8000
